# ---- ELHOE Verify ----
APP_NAME="ELHOE Verify"
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=https://verify.elhoe.com
APP_TIMEZONE=Asia/Dhaka

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elhoe_verify
DB_USER=elhoe_verify
DB_PASS=changeme
DB_CHARSET=utf8mb4

# ---- Cloudflare Turnstile ----
# Leave blank to disable (local dev only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Rate limiter (verification endpoint) ----
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SEC=600

# ---- IP geolocation ----
# Free tier endpoint. http://ip-api.com/json/{ip}?fields=status,country,regionName,city
GEOIP_ENDPOINT=http://ip-api.com/json/
GEOIP_TIMEOUT_SEC=2

# ---- Admin session ----
ADMIN_SESSION_NAME=elhoe_admin
ADMIN_SESSION_LIFETIME=10800   # 3 hours
