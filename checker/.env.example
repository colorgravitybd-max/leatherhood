# =====================================================================
#  ELHOE Verify - environment file.
#  On the server, copy this file to ".env" (same folder, no extension):
#       cp .env.example .env
#  ".env" is gitignored; ".env.example" is committed.
#  After upload, ROTATE THE DB PASSWORD AND APP SECRETS.
# =====================================================================

# ---- App ----
APP_NAME="ELHOE Verify"
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=https://elhoe.com
APP_BASE_PATH=/checker
APP_TIMEZONE=Asia/Dhaka

# ---- Database (Hostinger / cPanel format) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u991123247_elhoechecker
DB_USER=u991123247_checker
DB_PASS=Vent@2322
DB_CHARSET=utf8mb4

# ---- Cloudflare Turnstile ----
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to disable (local dev only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Rate limiter (verification endpoint) ----
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SEC=600

# ---- IP geolocation (free tier, ip-api.com) ----
GEOIP_ENDPOINT=http://ip-api.com/json/
GEOIP_TIMEOUT_SEC=2

# ---- Admin session ----
ADMIN_SESSION_NAME=elhoe_admin
ADMIN_SESSION_LIFETIME=10800
